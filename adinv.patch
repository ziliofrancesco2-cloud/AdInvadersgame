--- old/AdInvaders/app/src/main/java/com/crowclaw/adinvaders/ShipOverlay.kt
+++ AdInvaders/app/src/main/java/com/crowclaw/adinvaders/ShipOverlay.kt
@@ -0,0 +1,69 @@
+package com.crowclaw.adinvaders
+
+import android.content.Context
+import android.graphics.PixelFormat
+import android.os.Handler
+import android.os.Looper
+import android.provider.Settings
+import android.view.WindowManager
+
+/**
+ * Finestra trasparente sopra le altre app (browser compreso).
+ * Quando lo scudo blocca un annuncio mentre stai su un sito, la navicella entra dal basso,
+ * abbatte gli invasori nel punto dove c'erano gli annunci e poi se ne va.
+ * Non intercetta mai i tocchi: puoi continuare a usare il sito normalmente.
+ */
+class ShipOverlay(private val context: Context) {
+
+    private val wm = context.getSystemService(WindowManager::class.java)
+    private val main = Handler(Looper.getMainLooper())
+    private var view: GameView? = null
+
+    companion object {
+        private const val PREF = "settings"
+        private const val KEY = "overlay_on"
+
+        fun canShow(ctx: Context) = Settings.canDrawOverlays(ctx)
+
+        fun isEnabled(ctx: Context) =
+            ctx.getSharedPreferences(PREF, Context.MODE_PRIVATE).getBoolean(KEY, true)
+
+        fun setEnabled(ctx: Context, on: Boolean) =
+            ctx.getSharedPreferences(PREF, Context.MODE_PRIVATE).edit().putBoolean(KEY, on).apply()
+    }
+
+    /** Va chiamato sul main thread. */
+    fun show(domain: String) {
+        if (!isEnabled(context) || !canShow(context)) return
+        if (MainActivity.visible) return            // nell'app c'è già il gioco a schermo intero
+        val v = view ?: create() ?: return
+        v.addInvader(domain)
+    }
+
+    private fun create(): GameView? {
+        val v = GameView(context, overlay = true)
+        val lp = WindowManager.LayoutParams(
+            WindowManager.LayoutParams.MATCH_PARENT,
+            WindowManager.LayoutParams.MATCH_PARENT,
+            WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY,
+            WindowManager.LayoutParams.FLAG_NOT_TOUCHABLE or
+                WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE or
+                WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN,
+            PixelFormat.TRANSLUCENT
+        )
+        v.onIdle = { main.post { hide() } }
+        return try {
+            wm.addView(v, lp)
+            view = v
+            v
+        } catch (_: Exception) {
+            null
+        }
+    }
+
+    fun hide() {
+        val v = view ?: return
+        view = null
+        try { wm.removeView(v) } catch (_: Exception) {}
+    }
+}
